{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/ai",
      "destination": "/ai/index.html"
    },
    {
      "source": "/ai-solver",
      "destination": "/ai-solver/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/documents",
      "destination": "/documents/index.html"
    },
    {
      "source": "/flashcards",
      "destination": "/flashcards/index.html"
    },
    {
      "source": "/habit",
      "destination": "/habit/index.html"
    },
    {
      "source": "/handbook",
      "destination": "/handbook/index.html"
    },
    {
      "source": "/landing",
      "destination": "/landing/index.html"
    },
    {
      "source": "/pdf-editor",
      "destination": "/pdf-editor/index.html"
    },
    {
      "source": "/pdf-tools",
      "destination": "/pdf-tools/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/refunds",
      "destination": "/refunds/index.html"
    },
    {
      "source": "/scan-notes",
      "destination": "/scan-notes/index.html"
    },
    {
      "source": "/schools",
      "destination": "/schools/index.html"
